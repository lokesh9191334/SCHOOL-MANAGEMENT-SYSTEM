# Real email OTP (required)
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="School Management System <your.email@gmail.com>"

# Keep false for real inbox OTPs (do not show OTP on screen)
SMTP_ALLOW_DEMO=false

# Optional AI assistant (OpenAI-compatible chat completions endpoint)
# Keep these server-side; never add the API key to VITE_* variables.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-4o-mini

# Parent payment receiver details. Configure the real school account before enabling QR payments.
PAYMENT_HOLDER_NAME=Your School Name
PAYMENT_UPI_ID=school@upi
PAYMENT_MOBILE=+91 90000 00000

# Daily WhatsApp driver tracking link (Meta WhatsApp Cloud API)
# Create a Utility template whose body takes 4 placeholders:
#   1 driver name, 2 bus, 3 route, 4 tracking link
WHATSAPP_ACCESS_TOKEN=your_permanent_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_TEMPLATE_NAME=driver_daily_tracking_link
WHATSAPP_TEMPLATE_LANG=en
# Optional; default v20.0
WHATSAPP_API_VERSION=v20.0

# Required to protect the daily 6:00 AM IST cron endpoint.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate_a_long_random_value

# Public site URL used inside WhatsApp tracking links.
PUBLIC_APP_URL=https://www.schoolmanagementsystem.me
